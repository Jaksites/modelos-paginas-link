 <section id="como-funciona" class="how-it-works-section">
      <div class="how-container">
        <header class="how-header">
          <h2 class="category-title">Como Funciona?</h2>
          <p class="how-subtitle">
            Sem complicação! Você escolhe e nós cuidamos de tudo.
          </p>
        </header>

        <div class="steps-grid">
          <!-- Passo 01 -->
          <div class="step-card">
            <div class="step-number">01</div>
            <h3 class="step-title">Escolha seu modelo</h3>
            <p class="step-desc">
              Navegue pelo nosso catálogo e encontre o modelo ideal para o seu
              segmento ou estilo.
            </p>
          </div>

          <!-- Passo 02 -->
          <div class="step-card">
            <div class="step-number">02</div>
            <h3 class="step-title">Envie suas informações</h3>
            <p class="step-desc">
              Mande sua logo, fotos, textos, links e contatos. Nós orientamos
              tudo o que for necessário.
            </p>
          </div>

          <!-- Passo 03 -->
          <div class="step-card">
            <div class="step-number">03</div>
            <h3 class="step-title">Nós personalizamos</h3>
            <p class="step-desc">
              Configuramos a página com as suas cores, dados e links para ficar
              com a cara do seu negócio.
            </p>
          </div>

          <!-- Passo 04 -->
          <div class="step-card">
            <div class="step-number">04</div>
            <h3 class="step-title">Receba seu link</h3>
            <p class="step-desc">
              Entregamos seu Mini Site testado, com hospedagem inclusa e pronto
              para colar no perfil!
            </p>
          </div>
        </div>
      </div>
    </section>