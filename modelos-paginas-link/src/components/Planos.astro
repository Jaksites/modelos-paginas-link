---
---

<section id="planos" class="plans-section">
      <div class="plans-container">
        <header class="plans-header">
          <h2 class="category-title">Escolha o Plano Ideal</h2>
          <p class="plans-subtitle">
            Sem mensalidades ocultas. Escolha o modelo e comece hoje mesmo!
          </p>
        </header>

        <div class="plans-grid">
          <div class="plan-card">
            <div class="plan-header">
              <span class="plan-badge">Básico</span>
              <h3 class="plan-title">Serviços & Bio</h3>
              <p class="plan-ideal">
                Ideal para: Advogados, Médicos, Psicólogos, Nutricionistas e
                Serviços Gerais.
              </p>
              <div class="plan-price">
                <span class="price-currency">R$</span>
                <span class="price-value">39</span>
                <span class="price-cents">,99</span>
                <span class="price-period">/ pagamento único</span>
              </div>
            </div>

            <ul class="plan-features">
              <li><strong>1 ano </strong> online incluso</li>
              <li>
                <strong>Personalização Inicial:</strong> Foto/Logo, Cores, Bio e
                Textos
              </li>
              <li>
                <strong>Botões de Ação:</strong> WhatsApp, Redes Sociais e
                Localização
              </li>
              <li><strong>Entrega :</strong> Link configurado para sua bio</li>
              <li>Link no formato: <code>cliente.pages.dev</code></li>
            </ul>

            <div class="plan-footer">
              <a
                href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Servi%C3%A7os%20(R$%2039,99)"
                target="_blank"
                rel="noopener"
                class="btn-plan"
                >Escolher Plano Serviços</a
              >
            </div>
          </div>

          <div class="plan-card">
            <div class="plan-header">
              <span class="plan-badge">Divulgação</span>
              <h3 class="plan-title">Vitrine & Afiliados</h3>
              <p class="plan-ideal">
                Ideal para: Afiliados (Shopee/ML) e Divulgação de Links
                Externos.
              </p>
              <div class="plan-price">
                <span class="price-currency">R$</span>
                <span class="price-value">59</span>
                <span class="price-cents">,99</span>
                <span class="price-period">/ pagamento único</span>
              </div>
            </div>

            <ul class="plan-features">
              <li><strong>Tudo do Plano Serviços +</strong></li>
              <li><strong>Até 10 Produtos/Achadinhos</strong> cadastrados</li>
              <li>
                <strong>Links de Redirecionamento Direto:</strong> Botão vai
                para a Shopee, ML ou site externo
              </li>
              <li><strong>Organização por Categorias</strong> no topo</li>
              <li><strong>1 ano </strong> online incluso</li>
              <li></li>
            </ul>

            <div class="plan-footer">
              <a
                href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Vitrine/Afiliados%20(R$%2049,99)"
                target="_blank"
                rel="noopener"
                class="btn-plan"
                >Escolher Plano Afiliados</a
              >
            </div>
          </div>

          <div class="plan-card featured">
            <div class="plan-header">
              <span class="plan-badge badge-featured">Mais Completo</span>
              <h3 class="plan-title">Catálogo Interativo</h3>
              <p class="plan-ideal">
                Ideal para: Lojas, Delivery, Confeitaria, Docerias e Vendas
                Diretas.
              </p>
              <div class="plan-price">
                <span class="price-currency">R$</span>
                <span class="price-value">89</span>
                <span class="price-cents">,99</span>
                <span class="price-period">/ pagamento único</span>
              </div>
            </div>

            <ul class="plan-features">
              <li>
                <strong>Carrinho de Compras Integrado:</strong> Soma os itens
                automaticamente
              </li>
              <li>
                <strong>Checkout via WhatsApp:</strong> Formulário de endereço e
                dados de entrega
              </li>
              <li>
                <strong>Pedido Formatado:</strong> Envia a lista do pedido
                pronta no WhatsApp
              </li>
              <li><strong>Até 10 Itens Inicialmente</strong> cadastrados</li>
              <li><strong>1 ano </strong> online incluso</li>
            </ul>

            <div class="plan-footer">
              <a
                href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Cat%C3%A1logo%20com%20Carrinho%20(R$%2069,99)"
                target="_blank"
                rel="noopener"
                class="btn-plan btn-featured"
                >Escolher Catálogo Completo</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>