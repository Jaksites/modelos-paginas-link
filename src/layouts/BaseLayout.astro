---
import Header from '../components/catalogo/Header.astro';
import Footer from '../components/catalogo/Footer.astro';
import CartDrawer from '../components/catalogo/CartDrawer.astro';
import CheckoutModal from '../components/catalogo/CheckoutModal.astro';
import ProductModal from '../components/catalogo/ProductModal.astro'; 
import WhatsAppButton from '../components/catalogo/WhatsAppButton.astro';
import { siteConfig as defaultSiteConfig } from '../config/active';
import type { SiteConfig } from '../types';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  config?: SiteConfig; 
}

const { 
  config = defaultSiteConfig, 
  title = `${config.name} | Catálogo Virtual`, 
  description = config.tagline,
  image = '/og-image.jpg', // Coloque uma imagem padrão no diretório public/
  canonicalUrl = Astro.url.href
} = Astro.props;

const { theme } = config;
const siteUrl = Astro.site ? new URL(image, Astro.site).href : new URL(image, Astro.url.origin).href;
---

<!doctype html>
<html 
  lang="pt-BR"
  style={`
    --brand-primary: ${theme.primary};
    --brand-primary-hover: ${theme.primaryHover};
    --brand-accent: ${theme.accent};
    --brand-accent-text: ${theme.accentText};
    --brand-dark: ${theme.dark};
    --brand-surface: ${theme.surface};
  `}
>
  <head>
    <!-- Meta Tags Essenciais -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl} />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fontes e Ícones -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-surface text-gray-800 min-h-screen flex flex-col justify-between selection:bg-brand-accent selection:text-brand-accentText">
    <Header config={config as SiteConfig} />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10 w-full grow">
      <slot />
    </main>

    <Footer config={config as SiteConfig} />

    <CartDrawer />
    <CheckoutModal whatsappNumber={config.whatsappNumber} />
    <ProductModal />
    <WhatsAppButton phone={config.whatsappNumber} />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) window.lucide.createIcons();
      });
    </script>
  </body>
</html>