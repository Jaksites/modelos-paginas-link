---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryFilter from '../components/catalogo/CategoryFilter.astro';
import HeroBanner from '../components/catalogo/HeroBanner.astro';
import ProductGrid from '../components/catalogo/ProductGrid.astro';
import { siteConfig, products } from '../config/active';

// Importe os componentes da sua sacola:
import ProductModal from '../components/catalogo/ProductModal.astro'; 
import CartDrawer from '../components/catalogo/CartDrawer.astro';
import CartFloatingBar from '../components/catalogo/CartFloatingBar.astro';

const categories = [...new Set(products.map(p => p.category).filter(Boolean))];
---

<BaseLayout>
  <HeroBanner banner={siteConfig.banner} />
  
  <!-- Filtros -->
  <CategoryFilter categories={categories} />

  <!-- Grade de Produtos Dinâmica -->
  <ProductGrid products={products} />

  <!-- Componentes Interativos Globais -->
  <ProductModal />
  <CartDrawer />
  <CartFloatingBar 
  />
</BaseLayout>