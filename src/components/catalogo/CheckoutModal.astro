---
interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
---

<div 
  id="checkout-modal" 
  data-whatsapp={whatsappNumber}
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
>
  <!-- Backdrop -->
  <div id="checkout-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm cursor-pointer"></div>

  <!-- Modal Box -->
  <div class="relative bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh] z-10">
    <div class="p-5 bg-linear-to-r from-gray-900 to-slate-800 text-white flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold">Dados para Entrega</h3>
        <p class="text-xs text-gray-300">Preencha para enviar seu pedido no WhatsApp</p>
      </div>
      <button id="close-checkout-btn" type="button" class="p-1.5 text-gray-300 hover:text-white rounded-full transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="checkout-form" class="p-5 sm:p-6 overflow-y-auto flex flex-col gap-4 text-sm">
      <div>
        <label class="block font-semibold text-gray-700 mb-1" for="cust-name">Seu Nome Completo *</label>
        <input type="text" id="cust-name" required placeholder="Ex: Maria Silva" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none" />
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1" for="cust-phone">Seu WhatsApp *</label>
        <input type="tel" id="cust-phone" required placeholder="Ex: (11) 99999-8888" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none" />
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1" for="cust-address">Endereço de Entrega *</label>
        <input type="text" id="cust-address" required placeholder="Rua, número, complemento e bairro" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-gray-700 mb-1" for="cust-city">Cidade *</label>
          <input type="text" id="cust-city" required placeholder="Ex: São Paulo" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none" />
        </div>
        <div>
          <label class="block font-semibold text-gray-700 mb-1" for="cust-uf">Estado (UF) *</label>
          <input type="text" id="cust-uf" required maxlength="2" placeholder="SP" class="uppercase w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1" for="cust-payment">Forma de Pagamento *</label>
        <select id="cust-payment" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none bg-white">
          <option value="Pix (Aprovação Imediata)">Pix (Aprovação Imediata)</option>
          <option value="Cartão de Crédito">Cartão de Crédito (Link de Pagamento)</option>
          <option value="Boleto Bancário">Boleto Bancário</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1" for="cust-obs">Observações</label>
        <textarea id="cust-obs" rows="2" placeholder="Ex: Preferência de entrega, referências..." class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-primary outline-none"></textarea>
      </div>

      <button type="submit" class="w-full mt-2 py-3.5 bg-green-600 hover:bg-green-700 text-white font-bold rounded-2xl flex items-center justify-center gap-2 transition-all shadow-lg shadow-green-600/20 active:scale-[0.99]">
        <i data-lucide="message-square" class="w-5 h-5"></i>
        <span>Enviar Pedido pelo WhatsApp</span>
      </button>
    </form>
  </div>
</div>

<script>
  import { getCart, getCartTotals } from '../../scripts/cartStore';

  const modal = document.getElementById('checkout-modal');
  const backdrop = document.getElementById('checkout-backdrop');
  const closeBtn = document.getElementById('close-checkout-btn');
  const form = document.getElementById('checkout-form');

  function openCheckout() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    (window as any).lucide?.createIcons();
  }

  function closeCheckout() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  window.addEventListener('checkout:open', openCheckout);
  closeBtn?.addEventListener('click', closeCheckout);
  backdrop?.addEventListener('click', closeCheckout);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const whatsappNumber = modal?.dataset.whatsapp || '';
    const cart = getCart();
    const { totalPrice } = getCartTotals();

    const name = (document.getElementById('cust-name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('cust-phone') as HTMLInputElement).value.trim();
    const address = (document.getElementById('cust-address') as HTMLInputElement).value.trim();
    const city = (document.getElementById('cust-city') as HTMLInputElement).value.trim();
    const uf = (document.getElementById('cust-uf') as HTMLInputElement).value.trim().toUpperCase();
    const payment = (document.getElementById('cust-payment') as HTMLSelectElement).value;
    const obs = (document.getElementById('cust-obs') as HTMLTextAreaElement).value.trim();

    let msg = `🛍️ *NOVO PEDIDO*\n`;
    msg += `-------------------------------------------\n\n`;
    msg += `👤 *DADOS DO CLIENTE:*\n`;
    msg += `• *Nome:* ${name}\n`;
    msg += `• *WhatsApp:* ${phone}\n`;
    msg += `• *Endereço:* ${address}\n`;
    msg += `• *Cidade/UF:* ${city} / ${uf}\n\n`;

    msg += `📦 *ITENS DO PEDIDO:*\n`;
    cart.forEach((item, i) => {
      const sub = (item.product.price * item.quantity).toFixed(2).replace('.', ',');
      msg += `${i + 1}. *${item.product.name}*\n`;
      msg += `   └ Tam: ${item.selectedSize} | Qtd: ${item.quantity}x | R$ ${sub}\n`;
    });

    msg += `\n💰 *RESUMO FINANCEIRO:*\n`;
    msg += `• *Total dos Produtos:* R$ ${totalPrice.toFixed(2).replace('.', ',')}\n`;
    msg += `• *Forma de Pagamento:* ${payment}\n`;

    if (obs) {
      msg += `\n📝 *OBSERVAÇÕES:*\n${obs}\n`;
    }

    msg += `\n-------------------------------------------\n`;
    msg += `Aguardando confirmação de estoque e valor do frete! ✨`;

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });
</script>