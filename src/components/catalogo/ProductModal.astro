---
// src/components/catalogo/ProductModal.astro
---

<div 
  id="product-quickview-modal" 
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center p-0 sm:p-4 md:p-6"
>
  <!-- Backdrop Escuro com Blur -->
  <div id="quickview-backdrop" class="absolute inset-0 bg-neutral-950/70 backdrop-blur-sm cursor-pointer transition-opacity"></div>

  <!-- Caixa do Modal: Bottom-sheet no mobile e Card centralizado no Desktop -->
  <div class="relative bg-white w-full sm:max-w-2xl rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col md:flex-row max-h-[88vh] sm:max-h-[90vh] z-10 border-t sm:border border-neutral-100 transform transition-transform duration-300 ease-out">
    
    <!-- Puxador visual (Apenas Mobile) -->
    <div class="sm:hidden w-full flex justify-center pt-2.5 pb-1 bg-white cursor-pointer" id="mobile-drag-handle">
      <div class="w-10 h-1 rounded-full bg-neutral-300"></div>
    </div>

    <!-- Botão Fechar Flutuante -->
    <button 
      id="close-quickview-btn" 
      type="button"
      class="absolute top-3 right-3 z-30 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-neutral-600 hover:text-neutral-900 flex items-center justify-center shadow-md transition-all active:scale-95 cursor-pointer font-bold text-sm"
      aria-label="Fechar"
    >
      ✕
    </button>

    <!-- Imagem do Produto (Mais compacta no mobile para não empurrar as informações) -->
    <div class="w-full md:w-1/2 h-52 sm:h-64 md:h-auto md:aspect-auto bg-neutral-100 relative shrink-0">
      <img id="qv-img" src="" alt="" class="w-full h-full object-cover select-none" />
    </div>

    <!-- Área de Conteúdo e Ações -->
    <div class="p-4 sm:p-6 w-full md:w-1/2 flex flex-col justify-between overflow-y-auto">
      <div>
        <span id="qv-category" class="text-[9px] sm:text-[10px] font-bold text-neutral-400 uppercase tracking-widest"></span>
        <h3 id="qv-title" class="text-base sm:text-xl font-bold text-neutral-900 mt-0.5 sm:mt-1 leading-snug"></h3>
        
        <div class="mt-2 sm:mt-3">
          <span id="qv-price" class="text-lg sm:text-2xl font-black text-brand-primary"></span>
        </div>

        <p id="qv-description" class="text-xs text-neutral-500 mt-2 leading-relaxed hidden line-clamp-4 sm:line-clamp-none"></p>

        <!-- Seletor de Variações -->
        <div id="qv-variations-container" class="mt-3 sm:mt-4 hidden">
          <label class="block text-xs font-bold text-neutral-700 mb-1.5">Escolha uma opção:</label>
          <div id="qv-variations-list" class="flex flex-wrap gap-1.5 sm:gap-2"></div>
        </div>
      </div>

      <!-- Rodapé com Botão Fixo de Compra -->
      <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-neutral-100 pb-2 sm:pb-0">
        <button 
          id="qv-btn-add" 
          type="button"
          class="w-full py-3 sm:py-3.5 bg-brand-dark hover:bg-brand-primary active:scale-[0.98] text-white font-bold rounded-2xl flex items-center justify-center gap-2 transition-all shadow-md text-xs sm:text-sm cursor-pointer"
        >
          <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span>Adicionar à Sacola</span>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  import { addToCart } from '../../scripts/cartStore';

  const modal = document.getElementById('product-quickview-modal');
  const backdrop = document.getElementById('quickview-backdrop');
  const closeBtn = document.getElementById('close-quickview-btn');
  const dragHandle = document.getElementById('mobile-drag-handle');
  const imgEl = document.getElementById('qv-img') as HTMLImageElement;
  const catEl = document.getElementById('qv-category');
  const titleEl = document.getElementById('qv-title');
  const priceEl = document.getElementById('qv-price');
  const descEl = document.getElementById('qv-description');
  const varContainer = document.getElementById('qv-variations-container');
  const varList = document.getElementById('qv-variations-list');
  const btnAdd = document.getElementById('qv-btn-add');

  let currentProduct: any = null;
  let selectedVariation: any = null;

  function unlockScroll() {
    document.body.style.overflow = '';
  }

  function close() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    unlockScroll();
  }

  function open(detail: any) {
    if (!modal) return;

    try {
      const { product, variations = [], initialVariationIndex = 0 } = detail;
      if (!product) return;

      currentProduct = product;
      selectedVariation = variations[initialVariationIndex] || {
        name: 'Padrão',
        price: product.price,
        image: product.image
      };

      if (imgEl) imgEl.src = selectedVariation.image || product.image;
      if (catEl) catEl.textContent = product.category || '';
      if (titleEl) titleEl.textContent = product.name || '';
      
      const price = selectedVariation.price ?? product.price;
      if (priceEl) priceEl.textContent = `R$ ${Number(price).toFixed(2).replace('.', ',')}`;

      if (descEl) {
        if (product.description) {
          descEl.textContent = product.description;
          descEl.classList.remove('hidden');
        } else {
          descEl.classList.add('hidden');
        }
      }

      if (varContainer && varList) {
        if (variations.length > 1) {
          varContainer.classList.remove('hidden');
          varList.innerHTML = variations.map((v: any, idx: number) => `
            <button 
              type="button"
              data-var-idx="${idx}"
              class="px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold border transition-all cursor-pointer ${
                idx === initialVariationIndex 
                  ? 'bg-neutral-900 text-white border-neutral-900 shadow-xs' 
                  : 'bg-white text-neutral-700 border-neutral-200 hover:bg-neutral-50 active:bg-neutral-100'
              }"
            >
              ${v.name}
            </button>
          `).join('');

          varList.querySelectorAll('[data-var-idx]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = Number((e.currentTarget as HTMLElement).dataset.varIdx);
              selectedVariation = variations[idx];

              if (imgEl) imgEl.src = selectedVariation.image || product.image;
              if (priceEl) {
                const p = selectedVariation.price ?? product.price;
                priceEl.textContent = `R$ ${Number(p).toFixed(2).replace('.', ',')}`;
              }

              varList.querySelectorAll('button').forEach((b, bIdx) => {
                b.className = bIdx === idx 
                  ? 'px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold border transition-all bg-neutral-900 text-white border-neutral-900 shadow-xs' 
                  : 'px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold border transition-all bg-white text-neutral-700 border-neutral-200 hover:bg-neutral-50 active:bg-neutral-100';
              });
            });
          });
        } else {
          varContainer.classList.add('hidden');
        }
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';

    } catch (err) {
      console.error('Falha ao abrir modal:', err);
      unlockScroll();
    }
  }

  window.addEventListener('open-quickview', (e: any) => {
    open(e.detail);
  });

  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);
  dragHandle?.addEventListener('click', close);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  btnAdd?.addEventListener('click', () => {
    if (!currentProduct) return;
    const finalPrice = selectedVariation?.price ?? currentProduct.price;
    const finalImage = selectedVariation?.image || currentProduct.image;
    const sizeName = selectedVariation?.name || 'Padrão';

    addToCart(currentProduct, sizeName, finalPrice, finalImage, 1);
    close();
  });
</script>