---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<section class="relative z-20 mb-8 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
      <i data-lucide="sliders-horizontal" class="w-4 h-4 text-brand-primary"></i>
      Categorias
    </h3>
  </div>

  <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filters">
    {['Todos', ...categories].map((cat, idx) => (
      <button 
        type="button"
        data-category-btn={cat} 
        class={`category-btn relative z-10 shrink-0 px-4 py-2 rounded-2xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all cursor-pointer select-none ${
          idx === 0 
            ? 'bg-brand-dark text-white' 
            : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'
        }`}
      >
        {cat}
      </button>
    ))}
  </div>
</section>
<script>
  function setupCategoryFilter() {
    const filterContainer = document.getElementById('category-filters');
    if (!filterContainer) return;

    // Usamos delegação de evento no container: captura o clique MESMO se o mouse estiver na borda
    filterContainer.onclick = (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-category-btn]');
      if (!btn) return;

      const rawBtn = btn.getAttribute('data-category-btn') || '';
      const normalize = (str: string) => 
        str.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      const selected = normalize(rawBtn);
      const buttons = filterContainer.querySelectorAll<HTMLButtonElement>('[data-category-btn]');

      buttons.forEach(b => {
        b.className = 'category-btn relative z-10 shrink-0 px-4 py-2 rounded-2xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all cursor-pointer select-none bg-white text-gray-600 border border-gray-200 hover:bg-gray-50';
      });
      btn.className = 'category-btn relative z-10 shrink-0 px-4 py-2 rounded-2xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all cursor-pointer select-none bg-brand-dark text-white';

      const items = document.querySelectorAll<HTMLElement>('.product-item');
      const emptyState = document.getElementById('grid-empty-state');
      let visibleCount = 0;

      items.forEach(item => {
        const rawCat = item.getAttribute('data-product-category') || item.getAttribute('data-category') || '';
        const prodCat = normalize(rawCat);

        const matches = selected === 'todos' || prodCat === selected || prodCat.includes(selected) || selected.includes(prodCat);

        if (matches) {
          item.classList.remove('hidden');
          item.style.display = '';
          visibleCount++;
        } else {
          item.classList.add('hidden');
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    };
  }

  setupCategoryFilter();
  document.addEventListener('astro:page-load', setupCategoryFilter);
</script>