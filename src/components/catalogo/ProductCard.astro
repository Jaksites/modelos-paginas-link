---
// src/components/catalogo/ProductCard.astro
import type { Product, ProductVariation } from '../../types';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Normaliza variações
const variations: ProductVariation[] = product.variations && product.variations.length > 0
  ? product.variations
  : (product.sizes || []).map(s => ({ name: s, price: product.price, image: product.image }));

const hasMultiple = variations.length > 1;
const initialVariation = variations[0] || { name: 'Padrão', price: product.price, image: product.image };
const initialPrice = initialVariation.price ?? product.price;
const initialImage = initialVariation.image ?? product.image;

// Empacota os dados de forma 100% segura contra quebra de aspas e compilação do Astro
const safePayload = encodeURIComponent(JSON.stringify({ product, variations }));
---

<div 
  class="bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group product-item"
  data-card-id={product.id}
  data-product-payload={safePayload}
  data-category={product.category}
>
  <!-- Imagem com Ação de Abrir Modal -->
  <div class="relative w-full aspect-square overflow-hidden bg-neutral-100 cursor-pointer" data-open-modal>
    <img 
      data-card-img
      src={initialImage} 
      alt={product.name} 
      class="w-full h-full object-cover group-hover:scale-105 transition-all duration-300 ease-out select-none" 
      loading="lazy" 
    />
    
    {product.badge && (
      <span class="absolute top-2.5 left-2.5 z-10 bg-neutral-900/60 backdrop-blur-md text-white text-[9px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border border-white/20 shadow-sm">
        {product.badge}
      </span>
    )}

    <!-- Ícone de Olho / Abrir Detalhes -->
    <div 
      class="absolute top-2.5 right-2.5 z-10 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-neutral-700 hover:text-neutral-900 backdrop-blur-md flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110"
      title="Ver detalhes"
    >
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </div>

    <!-- Overlay no Hover para Desktop -->
    <div class="hidden sm:flex absolute inset-0 bg-neutral-950/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 items-center justify-center pointer-events-none">
      <span class="bg-white/95 backdrop-blur-md text-neutral-900 text-[11px] font-bold px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
        <svg class="w-3.5 h-3.5 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        Ver opções
      </span>
    </div>
  </div>

  <div class="p-3 sm:p-4 flex flex-col grow justify-between gap-2.5">
    <div>
      <span class="text-[9px] sm:text-[10px] font-bold text-neutral-400 uppercase tracking-widest block">
        {product.category}
      </span>
      <h4 
        class="font-bold text-neutral-900 text-xs sm:text-sm leading-snug line-clamp-2 h-8 sm:h-10 mt-0.5 cursor-pointer hover:text-neutral-600 transition-colors"
        data-open-modal
      >
        {product.name}
      </h4>
    </div>

    <div class="pt-2 border-t border-neutral-100 flex flex-col gap-2">
      <!-- Seletor de Variações -->
      {hasMultiple ? (
        <div class="relative w-full">
          <select 
            class="card-variation-select w-full appearance-none bg-neutral-50 hover:bg-neutral-100 text-[11px] sm:text-xs font-semibold text-neutral-700 py-1.5 px-2.5 pr-6 rounded-lg sm:rounded-xl border border-neutral-200/60 focus:outline-none focus:ring-1 focus:ring-neutral-900 transition-colors cursor-pointer truncate"
          >
            {variations.map((v, i) => (
              <option 
                value={v.name} 
                data-index={i}
                data-price={v.price ?? product.price} 
                data-image={v.image || product.image}
              >
                {v.name}
              </option>
            ))}
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none text-neutral-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
      ) : (
        <div class="w-full text-center text-[10px] sm:text-[11px] font-semibold text-neutral-400 py-1.5 px-2 bg-neutral-50/70 rounded-lg sm:rounded-xl border border-neutral-100 truncate">
          {initialVariation.name}
        </div>
      )}

      <!-- Preço e Botão Add -->
      <div class="flex items-center justify-between gap-1.5 mt-0.5">
        <span 
          data-card-price
          class="text-xs sm:text-base font-black text-neutral-900 tracking-tight truncate"
        >
          R$ {initialPrice.toFixed(2).replace('.', ',')}
        </span>

        <button 
          type="button"
          data-btn-add
          class="shrink-0 py-1.5 px-2.5 sm:py-2 sm:px-3 bg-neutral-900 hover:bg-neutral-800 active:scale-95 text-white font-bold text-xs rounded-lg sm:rounded-xl flex items-center justify-center gap-1 transition-all duration-200 shadow-sm cursor-pointer"
        >
          <svg class="btn-icon w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span class="btn-text text-[11px] sm:text-xs font-semibold">Add</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { addToCart } from '../../scripts/cartStore';

  // 1. Mudança no Dropdown (atualiza preço e imagem na hora)
  document.addEventListener('change', (e) => {
    const select = (e.target as HTMLElement)?.closest('.card-variation-select') as HTMLSelectElement | null;
    if (!select) return;

    const card = select.closest('[data-card-id]') as HTMLElement;
    if (!card) return;

    const opt = select.options[select.selectedIndex];
    if (!opt) return;

    const price = Number(opt.dataset.price);
    const image = opt.dataset.image;

    const priceEl = card.querySelector('[data-card-price]');
    if (priceEl && !isNaN(price)) {
      priceEl.textContent = `R$ ${price.toFixed(2).replace('.', ',')}`;
    }

    const imgEl = card.querySelector('[data-card-img]') as HTMLImageElement | null;
    if (imgEl && image) {
      imgEl.src = image;
    }
  });

  // 2. Clique no Botão "+ Add"
  document.addEventListener('click', (e) => {
    const addBtn = (e.target as HTMLElement)?.closest('[data-btn-add]') as HTMLElement | null;
    if (!addBtn) return;

    e.preventDefault();
    e.stopPropagation();

    const card = addBtn.closest('[data-card-id]') as HTMLElement;
    if (!card) return;

    const rawPayload = card.dataset.productPayload;
    if (!rawPayload) return;

    try {
      const { product, variations } = JSON.parse(decodeURIComponent(rawPayload));
      const select = card.querySelector('.card-variation-select') as HTMLSelectElement | null;
      
      let selectedSize = 'Padrão';
      let finalPrice = product.price;
      let finalImage = product.image;

      if (select && select.selectedOptions[0]) {
        const opt = select.selectedOptions[0];
        selectedSize = opt.value;
        finalPrice = Number(opt.dataset.price) || product.price;
        finalImage = opt.dataset.image || product.image;
      } else if (variations && variations[0]) {
        selectedSize = variations[0].name;
        finalPrice = variations[0].price ?? product.price;
        finalImage = variations[0].image || product.image;
      }

      addToCart(product, selectedSize, finalPrice, finalImage, 1);

      const btnText = addBtn.querySelector('.btn-text');
      const originalText = btnText ? btnText.textContent : 'Add';

      addBtn.classList.remove('bg-neutral-900', 'hover:bg-neutral-800');
      addBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      if (btnText) btnText.textContent = '✓';

      setTimeout(() => {
        addBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        addBtn.classList.add('bg-neutral-900', 'hover:bg-neutral-800');
        if (btnText) btnText.textContent = originalText;
      }, 700);
    } catch (err) {
      console.error('Erro ao adicionar produto:', err);
    }
  });

  // 3. Clique para Abrir o Modal de Detalhes
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement)?.closest('[data-open-modal]') as HTMLElement | null;
    if (!trigger) return;

    // Se clicou no select ou no botão add, não abre o modal
    if ((e.target as HTMLElement)?.closest('[data-btn-add]') || (e.target as HTMLElement)?.closest('select')) {
      return;
    }

    const card = trigger.closest('[data-card-id]') as HTMLElement;
    if (!card) return;

    const rawPayload = card.dataset.productPayload;
    if (!rawPayload) return;

    try {
      const data = JSON.parse(decodeURIComponent(rawPayload));
      const select = card.querySelector('.card-variation-select') as HTMLSelectElement | null;
      const initialVariationIndex = select ? select.selectedIndex : 0;

      window.dispatchEvent(new CustomEvent('open-quickview', { 
        detail: { ...data, initialVariationIndex } 
      }));
    } catch (err) {
      console.error('Erro ao decodificar produto para o modal:', err);
    }
  });
</script>