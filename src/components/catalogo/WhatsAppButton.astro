---
// src/components/catalogo/WhatsAppButton.astro (ou o nome do seu arquivo)
interface Props {
  phone: string;
  message?: string;
  label?: string;
}

const { 
  phone, 
  message = "Olá! Gostaria de tirar algumas dúvidas sobre os produtos do catálogo.",
  label = "Dúvidas? Fale Conosco" 
} = Astro.props;

// Limpa qualquer caractere não numérico do telefone
const cleanPhone = phone.replace(/\D/g, "");
const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${cleanPhone}?text=${encodedMessage}`;
---

<!-- Botão Flutuante do WhatsApp com transição suave controlada por ID -->
<aside 
  id="whatsapp-floating-btn" 
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 flex items-center transition-transform duration-300 ease-out"
>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Falar no WhatsApp"
    class="relative group flex items-center gap-2.5 bg-[#25D366] hover:bg-[#20ba59] text-white p-3.5 sm:px-4 sm:py-3 rounded-full shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 hover:scale-105 active:scale-95"
  >
    <!-- Efeito de Pulso -->
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500 border-2 border-white"></span>
    </span>

    <!-- Ícone Oficial do WhatsApp -->
    <svg
      class="w-6 h-6 fill-current"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.56 20.16 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.15 12.39 9.74 14.84 12.19 15.89C14.23 16.77 14.65 16.59 15.09 16.55C15.54 16.51 16.53 15.96 16.74 15.38C16.94 14.79 16.94 14.29 16.88 14.19C16.82 14.09 16.66 14.03 16.42 13.91C16.17 13.79 14.97 13.2 14.74 13.12C14.52 13.04 14.36 13 14.2 13.24C14.03 13.49 13.56 14.03 13.41 14.21C13.27 14.38 13.12 14.4 12.88 14.28C12.63 14.16 11.83 13.9 10.89 13.06C10.15 12.4 9.66 11.59 9.51 11.34C9.37 11.1 9.49 10.96 9.62 10.84C9.73 10.73 9.87 10.55 10 10.39C10.12 10.24 10.17 10.12 10.25 9.96C10.33 9.79 10.29 9.65 10.23 9.53C10.17 9.41 9.69 8.24 9.49 7.76C9.3 7.29 9.1 7.35 8.94 7.34C8.8 7.33 8.63 7.33 8.53 7.33Z" />
    </svg>

    <!-- Texto no Desktop -->
    {label && (
      <span class="hidden sm:inline font-bold text-xs sm:text-sm tracking-wide">
        {label}
      </span>
    )}
  </a>
</aside>

<script>
  function updateWhatsAppPosition() {
    const waBtn = document.getElementById('whatsapp-floating-btn');
    if (!waBtn) return;

    // Checa se há itens no carrinho
    let hasItems = false;
    try {
      const raw = localStorage.getItem('aura_store_cart');
      if (raw) {
        const cart = JSON.parse(raw);
        hasItems = Array.isArray(cart) && cart.some((item) => Number(item.quantity) > 0);
      }
    } catch {
      hasItems = false;
    }

    const isMobile = window.innerWidth < 640;

    // No mobile com itens no carrinho, sobe 76px; caso contrário, fica na posição padrão
    if (isMobile && hasItems) {
      waBtn.style.transform = 'translateY(-76px)';
    } else {
      waBtn.style.transform = 'translateY(0)';
    }
  }

  // Executa ao carregar
  updateWhatsAppPosition();

  // Escuta atualizações do carrinho e redimensionamentos da tela
  window.addEventListener('cart:updated', updateWhatsAppPosition);
  window.addEventListener('resize', updateWhatsAppPosition);
  document.addEventListener('astro:page-load', updateWhatsAppPosition);
</script>