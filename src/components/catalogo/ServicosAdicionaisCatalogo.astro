---
---
<section id="servicos-adicionais" class="services-section">
  <div class="services-container">
    <header class="services-header">
      <span class="section-tag">Manutenção & Expansão</span>
      <h2 class="category-title">Serviços Adicionais</h2>
      <p class="services-subtitle">
        Sua loja em constante evolução. Atualize produtos, adicione banners ou lance promoções quando quiser.
      </p>
    </header>

    <div class="table-responsive">
      <table class="services-table">
        <thead>
          <tr>
            <th>Serviço Adicional</th>
            <th>Descrição</th>
            <th>Valor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Serviço Adicional">
              <strong class="service-name">Alteração Simples / Ponto Único</strong>
            </td>
            <td data-label="Descrição">
              Atualização de até 3 dados pontuais (ex: alteração de número do WhatsApp, chave PIX, endereço de retirada ou texto informativo).
            </td>
            <td data-label="Valor" class="price-cell">R$ 9,99</td>
          </tr>

          <tr>
            <td data-label="Serviço Adicional">
              <strong class="service-name">Pacote +10 Produtos / Fotos</strong>
            </td>
            <td data-label="Descrição">
              Cadastro ou substituição de até 10 novos produtos com fotos, descrição, variações (cor/tamanho) e preços.
            </td>
            <td data-label="Valor" class="price-cell">R$ 19,99</td>
          </tr>

          <tr>
            <td data-label="Serviço Adicional">
              <strong class="service-name">Pacote +25 Produtos / Fotos</strong>
            </td>
            <td data-label="Descrição">
              Cadastro ou substituição massiva de até 25 novos itens na sua vitrine com todas as descrições e fotos tratadas.
            </td>
            <td data-label="Valor" class="price-cell">R$ 39,99</td>
          </tr>

          <tr>
            <td data-label="Serviço Adicional">
              <strong class="service-name">Domínio Próprio (.com.br)</strong>
            </td>
            <td data-label="Descrição">
              Registro oficial no seu CPF/CNPJ via Registro.br (R$ 40/ano) + taxa de configuração e apontamento no servidor (R$ 29,99 única).
            </td>
            <td data-label="Valor" class="price-cell">
              R$ 69,99
              <span class="setup-tag">(R$ 40 Domínio + R$ 29,99 Setup)</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
.services-section {
  padding: 80px 20px;
  background-color: #000000;
  border-top: 1px solid rgba(148, 70, 242, 0.15);
  font-family: 'Inter', sans-serif;
}

.services-container {
  max-width: 1000px;
  margin: 0 auto;
}

.services-header {
  text-align: center;
  margin-bottom: 48px;
}

.section-tag {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #9446f2;
  background: rgba(148, 70, 242, 0.12);
  border: 1px solid rgba(148, 70, 242, 0.25);
  padding: 5px 14px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.category-title {
  font-family: 'Sora', sans-serif;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #ffffff;
}

.services-subtitle {
  color: #c4b8d7;
  font-size: 0.98rem;
  margin-top: 8px;
}

.table-responsive {
  width: 100%;
  overflow-x: auto;
  border-radius: 16px;
  border: 1px solid rgba(148, 70, 242, 0.2);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.services-table {
  width: 100%;
  border-collapse: collapse;
  background-color: rgba(26, 18, 36, 0.8);
  text-align: left;
  font-size: 0.93rem;
}

.services-table th {
  background-color: rgba(58, 1, 112, 0.4);
  color: #ffffff;
  font-family: 'Sora', sans-serif;
  padding: 18px 20px;
  font-weight: 700;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 1px solid rgba(148, 70, 242, 0.2);
}

.services-table td {
  padding: 20px;
  border-bottom: 1px solid rgba(148, 70, 242, 0.12);
  color: #c4b8d7;
  line-height: 1.55;
}

.service-name {
  color: #ffffff;
  font-family: 'Sora', sans-serif;
  font-size: 0.98rem;
}

.services-table tr:last-child td {
  border-bottom: none;
}

.services-table tr:hover {
  background-color: rgba(148, 70, 242, 0.06);
}

.price-cell {
  font-family: 'Sora', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  color: #9446f2;
  white-space: nowrap;
}

.setup-tag {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  color: #c4b8d7;
  margin-top: 4px;
}

/* Layout Responsivo em Cards para Mobile */
@media (max-width: 680px) {
  .services-section {
    padding: 50px 16px;
  }

  .table-responsive {
    border: none;
    box-shadow: none;
    background: transparent;
  }

  .services-table thead {
    display: none;
  }

  .services-table,
  .services-table tbody,
  .services-table tr,
  .services-table td {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .services-table tr {
    margin-bottom: 16px;
    border: 1px solid rgba(148, 70, 242, 0.2);
    border-radius: 14px;
    background-color: rgba(26, 18, 36, 0.9);
    padding: 16px;
  }

  .services-table td {
    padding: 8px 0;
    border-bottom: none;
    text-align: left;
  }

  .services-table td::before {
    content: attr(data-label);
    display: block;
    font-family: 'Sora', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #9446f2;
    margin-bottom: 4px;
  } 

  .service-name {
    font-size: 1.1rem;
  }

  .price-cell {
    margin-top: 6px;
    padding-top: 10px !important;
    border-top: 1px dashed rgba(148, 70, 242, 0.25) !important;
    font-size: 1.2rem;
  }
}
</style>