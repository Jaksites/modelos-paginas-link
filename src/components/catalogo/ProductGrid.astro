---
import ProductCard from './ProductCard.astro';
import type { Product } from '../../types';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="w-full">
  <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6 px-3 sm:px-0">
    {products.map((product) => (
      <ProductCard product={product} />
    ))}
  </div>

  <!-- Estado vazio quando o filtro não achar peças -->
  <div id="grid-empty-state" class="hidden py-16 text-center text-gray-400">
    <i data-lucide="package-search" class="w-12 h-12 mx-auto mb-2 stroke-1 text-gray-300"></i>
    <p class="text-sm font-medium">Nenhum produto encontrado nesta categoria.</p>
  </div>
</div>