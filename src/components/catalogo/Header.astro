---
import type { SiteConfig } from '../../types';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
---

<header class="sticky top-0 z-30 w-full bg-white/85 backdrop-blur-md border-b border-gray-200/80 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    <!-- Logo + Nome da Loja -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      {config.logoUrl ? (
        <img 
          src={config.logoUrl} 
          alt={`Logo ${config.name}`} 
          class="w-10 h-10 sm:w-12 sm:h-12 rounded-full object-cover border border-gray-200/80 shadow-xs group-hover:scale-105 transition-transform"
        />
      ) : (
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-brand-dark text-white flex items-center justify-center font-extrabold text-lg tracking-wider shrink-0 group-hover:bg-brand-primary transition-colors">
          {config.name.charAt(0)}
        </div>
      )}

      <div>
        <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-gray-900 leading-none">
          {config.name.split(' ')[0]} <span class="text-brand-primary">{config.name.split(' ').slice(1).join(' ')}</span>
        </h1>
        <p class="text-[11px] text-gray-500 font-medium mt-0.5">{config.tagline}</p>
      </div>
    </a>

    <!-- Botão do Carrinho -->
    <button id="open-cart-btn" class="relative p-2.5 sm:px-4 sm:py-2.5 bg-brand-dark hover:bg-brand-primary text-white rounded-2xl flex items-center gap-2.5 transition-all shadow-md active:scale-95">
      <i data-lucide="shopping-bag" class="w-5 h-5"></i>
      <span class="hidden sm:inline font-semibold text-sm">Meu Carrinho</span>
      <span id="cart-badge" class="hidden bg-brand-primary text-white text-xs font-black px-2 py-0.5 rounded-full border-2 border-brand-dark animate-pulse">
        0
      </span>
    </button>
  </div>
</header>

<script>
  import { getCartTotals } from '../../scripts/cartStore';

  const badge = document.getElementById('cart-badge');
  const btn = document.getElementById('open-cart-btn');

  function updateBadge() {
    const { totalCount } = getCartTotals();
    if (totalCount > 0) {
      badge?.classList.remove('hidden');
      if (badge) badge.textContent = String(totalCount);
    } else {
      badge?.classList.add('hidden');
    }
  }

  btn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  window.addEventListener('cart:updated', updateBadge);
  document.addEventListener('DOMContentLoaded', updateBadge);
</script>