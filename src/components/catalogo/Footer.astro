---
import type { SiteConfig } from '../../types';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const currentYear = new Date().getFullYear();

// Suporte retrocompatível: pega do objeto socials OU da raiz do config
const instagram = config.socials?.instagram || config.instagramUrl;
const whatsapp = config.socials?.whatsapp || config.whatsappNumber;
const facebook = config.socials?.facebook;
const tiktok = config.socials?.tiktok;

// Limpeza de caracteres não-numéricos para o link do WhatsApp
const cleanPhone = whatsapp ? whatsapp.replace(/\D/g, '') : '';
---

<footer class="bg-white border-t border-gray-200 mt-20 pt-14 pb-8 text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- GRID PRINCIPAL -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 pb-12 border-b border-gray-100">
      
      <!-- Coluna 1: Marca & Redes Sociais com SVG -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-3">
          {config.logoUrl ? (
            <img 
              src={config.logoUrl} 
              alt={config.name} 
              class="w-10 h-10 rounded-full object-cover border border-gray-100 shadow-xs" 
            />
          ) : (
            <div class="w-10 h-10 rounded-full bg-brand-dark text-white flex items-center justify-center font-extrabold text-base tracking-wider">
              {config.name.charAt(0)}
            </div>
          )}
          <div>
            <span class="font-extrabold text-gray-900 text-base tracking-tight leading-none">
              {config.name}
            </span>
            <p class="text-[11px] text-gray-500 font-medium mt-0.5">{config.tagline}</p>
          </div>
        </div>

        <p class="text-xs text-gray-500 leading-relaxed mt-2">
          {config.shippingNotice || "Produtos de alta qualidade com atendimento personalizado e entregas seguras."}
        </p>

        <!-- Ícones Sociais Oficiais em SVG Puro -->
        <div class="flex items-center gap-2 mt-2">
          
          <!-- INSTAGRAM -->
          {instagram && (
            <a 
              href={instagram} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-[#E1306C] hover:text-white text-gray-600 flex items-center justify-center transition-all shadow-xs group"
              aria-label="Instagram"
            >
              <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}

          <!-- WHATSAPP -->
          {cleanPhone && (
            <a 
              href={`https://wa.me/${cleanPhone}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-[#25D366] hover:text-white text-gray-600 flex items-center justify-center transition-all shadow-xs group"
              aria-label="WhatsApp"
            >
              <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.56 20.16 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.15 12.39 9.74 14.84 12.19 15.89C14.23 16.77 14.65 16.59 15.09 16.55C15.54 16.51 16.53 15.96 16.74 15.38C16.94 14.79 16.94 14.29 16.88 14.19C16.82 14.09 16.66 14.03 16.42 13.91C16.17 13.79 14.97 13.2 14.74 13.12C14.52 13.04 14.36 13 14.2 13.24C14.03 13.49 13.56 14.03 13.41 14.21C13.27 14.38 13.12 14.4 12.88 14.28C12.63 14.16 11.83 13.9 10.89 13.06C10.15 12.4 9.66 11.59 9.51 11.34C9.37 11.1 9.49 10.96 9.62 10.84C9.73 10.73 9.87 10.55 10 10.39C10.12 10.24 10.17 10.12 10.25 9.96C10.33 9.79 10.29 9.65 10.23 9.53C10.17 9.41 9.69 8.24 9.49 7.76C9.3 7.29 9.1 7.35 8.94 7.34C8.8 7.33 8.63 7.33 8.53 7.33Z"/>
              </svg>
            </a>
          )}

          <!-- FACEBOOK -->
          {facebook && (
            <a 
              href={facebook} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-[#1877F2] hover:text-white text-gray-600 flex items-center justify-center transition-all shadow-xs group"
              aria-label="Facebook"
            >
              <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}

          <!-- TIKTOK -->
          {tiktok && (
            <a 
              href={tiktok} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-black hover:text-white text-gray-600 flex items-center justify-center transition-all shadow-xs group"
              aria-label="TikTok"
            >
              <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          )}

        </div>
      </div>

      <!-- Coluna 2: Atendimento e Localização -->
      <div class="flex flex-col gap-3">
        <h4 class="font-bold text-gray-900 text-xs uppercase tracking-wider">Atendimento & Contato</h4>
        
        <ul class="flex flex-col gap-2.5 text-xs text-gray-600">
          <li class="flex items-start gap-2.5">
            <i data-lucide="map-pin" class="w-4 h-4 text-brand-primary shrink-0 mt-0.5"></i>
            <span>{config.contact?.address || "Atendimento online para todo o Brasil"}</span>
          </li>

          {config.contact?.businessHours && (
            <li class="flex items-start gap-2.5">
              <i data-lucide="clock" class="w-4 h-4 text-brand-primary shrink-0 mt-0.5"></i>
              <span>{config.contact.businessHours}</span>
            </li>
          )}

          {cleanPhone && (
            <li class="flex items-center gap-2.5">
              <i data-lucide="phone" class="w-4 h-4 text-brand-primary shrink-0"></i>
              <a href={`https://wa.me/${cleanPhone}`} class="hover:text-brand-primary transition-colors font-medium">
                WhatsApp: {whatsapp}
              </a>
            </li>
          )}

          {config.contact?.email && (
            <li class="flex items-center gap-2.5">
              <i data-lucide="mail" class="w-4 h-4 text-brand-primary shrink-0"></i>
              <a href={`mailto:${config.contact.email}`} class="hover:text-brand-primary transition-colors">
                {config.contact.email}
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Coluna 3: Formas de Pagamento -->
      <div class="flex flex-col gap-3">
        <h4 class="font-bold text-gray-900 text-xs uppercase tracking-wider">Formas de Pagamento</h4>
        <p class="text-xs text-gray-500">Pague com agilidade e segurança na confirmação do pedido:</p>
        
        <div class="flex flex-wrap gap-2 text-xs font-semibold text-gray-700">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 border border-gray-200/80 rounded-xl">
            <i data-lucide="zap" class="w-3.5 h-3.5 text-emerald-500"></i> Pix
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 border border-gray-200/80 rounded-xl">
            <i data-lucide="credit-card" class="w-3.5 h-3.5 text-blue-500"></i> Cartão
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 border border-gray-200/80 rounded-xl">
            <i data-lucide="file-text" class="w-3.5 h-3.5 text-amber-500"></i> Boleto
          </span>
        </div>
      </div>

      <!-- Coluna 4: Segurança -->
      <div class="flex flex-col gap-3">
        <h4 class="font-bold text-gray-900 text-xs uppercase tracking-wider">Compra Segura</h4>
        
        <div class="p-3 bg-gray-50 border border-gray-100 rounded-2xl flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-900">Atendimento Direto</p>
            <p class="text-[11px] text-gray-500">Negociação transparente direto com a loja</p>
          </div>
        </div>

        <div class="p-3 bg-gray-50 border border-gray-100 rounded-2xl flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-brand-accent text-brand-primary flex items-center justify-center shrink-0">
            <i data-lucide="truck" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-900">Envio Garantido</p>
            <p class="text-[11px] text-gray-500">Embalagem protegida e rastreada</p>
          </div>
        </div>
      </div>

    </div>

    <!-- RODAPÉ INFERIOR -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
      <div>
        <p>© {currentYear} {config.name}. Todos os direitos reservados.</p>
        {config.contact?.cnpj && (
          <p class="text-[10px] text-center text-gray-400 mt-0.5">CNPJ: {config.contact.cnpj}</p>
        )}
      </div>

      <p class="text-gray-400 text-center sm:text-right">
        Desenvolvido por  
        <a href="https://jakdigitaldesign.com" target="_blank" class="text-brand-primary hover:text-brand-primary-hover underline">
           Jak Digital Design
        </a>
      </p>
    </div>

  </div>
</footer>