<script>
  (function () {
    var tabs = document.querySelectorAll(".category-btn");
    var sections = document.querySelectorAll(".category-section");

    function activate(target, updateHash) {
      sections.forEach(function (section) {
        section.classList.toggle("is-active", section.id === target);
      });
      tabs.forEach(function (tab) {
        var isActive = tab.dataset.target === target;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      if (updateHash && history.replaceState) {
        history.replaceState(null, "", "#" + target);
      }
    }

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function (event) {
        event.preventDefault();
        activate(tab.dataset.target, true);
        document
          .getElementById("modelos")
          .scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    var initial = window.location.hash
      ? window.location.hash.replace("#", "")
      : null;
    var validTargets = Array.prototype.map.call(tabs, function (t) {
      return t.dataset.target;
    });
    if (initial && validTargets.indexOf(initial) !== -1) {
      activate(initial, false);
    }
  })();
</script>