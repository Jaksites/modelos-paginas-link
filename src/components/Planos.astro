---
---
<section id="planos" class="plans-section">
  <div class="plans-container">
    <header class="plans-header">
      <span class="section-tag">Transparência Total</span>
      <h2 class="category-title">Escolha o Plano Ideal</h2>
      <p class="plans-subtitle">
        Sem mensalidades ocultas ou assinaturas. Pagamento único para ter seu site no ar.
      </p>
    </header>

    <div class="plans-grid">
      <!-- PLANO 1 -->
      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-badge">Básico</span>
          <h3 class="plan-title">Serviços & Bio</h3>
          <p class="plan-ideal">
            Ideal para: Advogados, Médicos, Psicólogos, Nutricionistas e Serviços Gerais.
          </p>
          <div class="plan-price">
            <span class="price-currency">R$</span>
            <span class="price-value">39</span>
            <span class="price-cents">,99</span>
            <span class="price-period">/ pagamento único</span>
          </div>
        </div>

        <ul class="plan-features">
          <li><strong>1 ano online</strong> incluso</li>
          <li><strong>Personalização Inicial:</strong> Foto/Logo, Cores, Bio e Textos</li>
          <li><strong>Botões de Ação:</strong> WhatsApp, Redes Sociais e Localização</li>
          <li><strong>Entrega Rápida:</strong> Link configurado para sua bio</li>
          <li>Link no formato: <code>cliente.pages.dev</code></li>
        </ul>

        <div class="plan-footer">
          <a
            href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Servi%C3%A7os%20(R$%2039,99)"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-plan"
          >
            Escolher Plano Serviços
          </a>
        </div>
      </div>

      <!-- PLANO 2 -->
      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-badge">Divulgação</span>
          <h3 class="plan-title">Vitrine & Afiliados</h3>
          <p class="plan-ideal">
            Ideal para: Afiliados (Shopee/ML) e Divulgação de Links Externos.
          </p>
          <div class="plan-price">
            <span class="price-currency">R$</span>
            <span class="price-value">59</span>
            <span class="price-cents">,99</span>
            <span class="price-period">/ pagamento único</span>
          </div>
        </div>

        <ul class="plan-features">
          <li><strong>Tudo do Plano Serviços +</strong></li>
          <li><strong>Até 10 Produtos/Achadinhos</strong> cadastrados</li>
          <li><strong>Redirecionamento Direto:</strong> Botões vão para Shopee, ML ou site externo</li>
          <li><strong>Organização por Categorias</strong> no topo</li>
          <li><strong>1 ano online</strong> incluso</li>
        </ul>

        <div class="plan-footer">
          <a
            href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Vitrine/Afiliados%20(R$%2059,99)"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-plan"
          >
            Escolher Plano Afiliados
          </a>
        </div>
      </div>

      <!-- PLANO 3 (DESTAQUE) -->
      <div class="plan-card featured">
        <div class="featured-tag">Mais Recomendado</div>
        <div class="plan-header">
          <span class="plan-badge badge-featured">Mais Completo</span>
          <h3 class="plan-title">Catálogo Interativo</h3>
          <p class="plan-ideal">
            Ideal para: Lojas, Delivery, Confeitaria, Docerias e Vendas Diretas.
          </p>
          <div class="plan-price">
            <span class="price-currency">R$</span>
            <span class="price-value">89</span>
            <span class="price-cents">,99</span>
            <span class="price-period">/ pagamento único</span>
          </div>
        </div>

        <ul class="plan-features">
          <li><strong>Carrinho de Compras Integrado:</strong> Soma os itens automaticamente</li>
          <li><strong>Checkout via WhatsApp:</strong> Formulário com dados de entrega</li>
          <li><strong>Pedido Formatado:</strong> Envia a lista do pedido pronta para você</li>
          <li><strong>Até 10 Itens Inicialmente</strong> cadastrados</li>
          <li><strong>1 ano online</strong> incluso</li>
        </ul>

        <div class="plan-footer">
          <a
            href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20contratar%20o%20Plano%20Cat%C3%A1logo%20com%20Carrinho%20(R$%2089,99)"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-plan btn-featured"
          >
            Escolher Catálogo Completo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap');

.plans-section {
  padding: 80px 20px;
  background-color: var(--bg-soft, #110c16);
  border-top: 1px solid var(--border-soft, rgba(168, 85, 247, 0.15));
  font-family: 'Inter', sans-serif;
}

.plans-container {
  max-width: 1200px;
  margin: 0 auto;
}

.plans-header {
  text-align: center;
  margin-bottom: 56px;
}

.section-tag {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--highlight, #a855f7);
  background: rgba(168, 85, 247, 0.12);
  border: 1px solid rgba(168, 85, 247, 0.25);
  padding: 5px 14px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.category-title {
  font-family: 'Sora', sans-serif;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #ffffff;
}

.plans-subtitle {
  color: var(--text-muted, #c4b8d7);
  font-size: 1rem;
  margin-top: 10px;
}

.plans-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
  align-items: stretch;
}

.plan-card {
  background: var(--bg-elevated, #1a1422);
  border: 1px solid var(--border-soft, rgba(168, 85, 247, 0.18));
  border-radius: 20px;
  padding: 36px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.plan-card:hover {
  transform: translateY(-6px);
  border-color: rgba(168, 85, 247, 0.4);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

/* Card em Destaque */
.plan-card.featured {
  border: 2px solid var(--highlight, #a855f7);
  background: linear-gradient(180deg, rgba(168, 85, 247, 0.15) 0%, var(--bg-elevated, #1a1422) 40%);
  box-shadow: 0 15px 35px rgba(168, 85, 247, 0.2);
}

.featured-tag {
  position: absolute;
  top: -14px;
  right: 24px;
  background: linear-gradient(135deg, var(--primary, #8343c3), var(--highlight, #a855f7));
  color: #ffffff;
  font-family: 'Sora', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 14px;
  border-radius: 12px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
}

.plan-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 20px;
  background-color: rgba(168, 85, 247, 0.14);
  color: var(--text-muted, #c4b8d7);
  margin-bottom: 16px;
}

.badge-featured {
  background: rgba(168, 85, 247, 0.25);
  color: #ffffff;
}

.plan-title {
  font-family: 'Sora', sans-serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
}

.plan-ideal {
  font-size: 0.88rem;
  color: var(--text-muted, #c4b8d7);
  line-height: 1.5;
  margin-bottom: 24px;
  min-height: 42px;
}

.plan-price {
  margin-bottom: 24px;
  color: #ffffff;
}

.price-currency {
  font-size: 1rem;
  font-weight: 600;
  vertical-align: top;
}

.price-value {
  font-family: 'Sora', sans-serif;
  font-size: 2.8rem;
  font-weight: 800;
  line-height: 1;
}

.price-cents {
  font-size: 1.2rem;
  font-weight: 700;
}

.price-period {
  font-size: 0.82rem;
  color: var(--text-muted, #c4b8d7);
  display: block;
  margin-top: 6px;
}

.plan-features {
  list-style: none;
  padding-top: 24px;
  margin: 0 0 32px 0;
  border-top: 1px solid var(--border-soft, rgba(168, 85, 247, 0.15));
}

.plan-features li {
  font-size: 0.92rem;
  color: var(--text-muted, #c4b8d7);
  margin-bottom: 14px;
  position: relative;
  padding-left: 26px;
  line-height: 1.45;
}

.plan-features li strong {
  color: #ffffff;
}

.plan-features li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--highlight, #a855f7);
  font-weight: 800;
}

.plan-features code {
  background-color: rgba(168, 85, 247, 0.15);
  color: #ffffff;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.82em;
}

.btn-plan {
  display: block;
  width: 100%;
  padding: 14px 18px;
  text-align: center;
  background-color: rgba(168, 85, 247, 0.12);
  color: #ffffff;
  text-decoration: none;
  font-family: 'Sora', sans-serif;
  font-size: 0.92rem;
  font-weight: 700;
  border-radius: 10px;
  border: 1px solid var(--border-strong, rgba(168, 85, 247, 0.35));
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.btn-plan:hover {
  background-color: rgba(168, 85, 247, 0.25);
  border-color: var(--highlight, #a855f7);
  transform: translateY(-2px);
}

.btn-featured {
  background: linear-gradient(135deg, var(--primary, #8343c3), var(--highlight, #a855f7));
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(168, 85, 247, 0.35);
}

.btn-featured:hover {
  filter: brightness(1.1);
  box-shadow: 0 8px 25px rgba(168, 85, 247, 0.5);
}

@media (max-width: 640px) {
  .plans-section {
    padding: 50px 16px;
  }
  
  .plan-ideal {
    min-height: auto;
  }
}
</style>