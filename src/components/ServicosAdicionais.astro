---
 
 <section id="servicos-adicionais" class="services-section">
      <div class="services-container">
        <header class="services-header">
          <h2 class="category-title">Serviços Adicionais & Manutenção</h2>
          <p class="services-subtitle">
            Transparência total: precise de atualizações ou melhorias a qualquer
            momento com preços acessíveis.
          </p>
        </header>

        <div class="table-responsive">
          <table class="services-table">
            <thead>
              <tr>
                <th>Serviço Adicional</th>
                <th>Descrição</th>
                <th>Valor</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="Serviço Adicional">
                  <strong>Alteração Simples</strong>
                </td>
                <td data-label="Descrição">
                  Troca de 1 a 3 informações simples (ex: trocar número do
                  WhatsApp, chave PIX, endereço ou texto da bio).
                </td>
                <td data-label="Valor" class="price-cell">R$ 9,99</td>
              </tr>
              <tr>
                <td data-label="Serviço Adicional">
                  <strong>Pacote +10 Produtos / Links</strong>
                </td>
                <td data-label="Descrição">
                  Cadastro ou substituição de até 10 novos produtos ou links de
                  afiliados com foto e link.
                </td>
                <td data-label="Valor" class="price-cell">R$ 14,99</td>
              </tr>
              <tr>
                <td data-label="Serviço Adicional">
                  <strong>Pacote +20 Produtos / Links</strong>
                </td>
                <td data-label="Descrição">
                  Cadastro ou substituição de até 20 novos produtos ou links.
                </td>
                <td data-label="Valor" class="price-cell">R$ 24,99</td>
              </tr>
              <tr>
                <td data-label="Serviço Adicional">
                  <strong>Domínio Próprio (.com.br)</strong>
                </td>
                <td data-label="Descrição">
                  Registro oficial no seu CPF/CNPJ via Registro.br (R$ 40/ano) +
                  taxa de configuração e apontamento no servidor (R$ 29,99
                  única).
                </td>
                <td data-label="Valor" class="price-cell">
                  R$ 69,99
                  <span class="setup-tag"
                    >(R$ 40 Domínio + R$ 29,99 Setup)</span
                  >
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>